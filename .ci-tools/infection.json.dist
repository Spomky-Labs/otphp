{
    "source": {
        "directories": [
            "../src"
        ]
    },
    "timeout": 3,
    "phpUnit": {
        "customPath": "/tools/phpunit-11"
    },
    "logs": {
        "text": "infection.txt"
    },
    "mutators": {
        "@default": true,
        "global-ignoreSourceCodeByRegex": [
            "\\$this->logger.*",
            "\\$this->cache->save.*",
            "parent::build(\\$container);"
        ]
    }
}
