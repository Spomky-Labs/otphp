parameters:
	level: max
	scanDirectories:
		- %rootDir%/../../../../phpunit/vendor
		- %currentWorkingDirectory%/vendor
	paths:
		- %currentWorkingDirectory%/src
	banned_code:
		non_ignorable: false
	checkUninitializedProperties: true
	treatPhpDocTypesAsCertain: false
	# Kept out of the generated baseline: with bleedingEdge, PHPStan does not match
	# its own "rawMessage: @@..." entries for messages starting with "@".
	# See https://github.com/phpstan/phpstan/issues/15337
	ignoreErrors:
		-
			message: '#^@readonly property OTPHP\\OTP\:\:\$issuer is assigned outside of the constructor\.$#'
			identifier: property.readOnlyByPhpDocAssignNotInConstructor
			count: 1
			path: ../src/OTP.php
		-
			message: '#^@readonly property OTPHP\\OTP\:\:\$issuer_included_as_parameter is assigned outside of the constructor\.$#'
			identifier: property.readOnlyByPhpDocAssignNotInConstructor
			count: 2
			path: ../src/OTP.php
		-
			message: '#^@readonly property OTPHP\\OTP\:\:\$label is assigned outside of the constructor\.$#'
			identifier: property.readOnlyByPhpDocAssignNotInConstructor
			count: 1
			path: ../src/OTP.php
		-
			message: '#^@readonly property OTPHP\\OTP\:\:\$parameters is assigned outside of the constructor\.$#'
			identifier: property.readOnlyByPhpDocAssignNotInConstructor
			count: 1
			path: ../src/OTP.php
		-
			message: '#^@readonly property cannot have a default value\.$#'
			identifier: property.readOnlyByPhpDocDefaultValue
			count: 4
			path: ../src/OTP.php

includes:
	- %currentWorkingDirectory%/.ci-tools/phpstan-baseline.neon
	- %rootDir%/conf/bleedingEdge.neon
	- %rootDir%/../../ekino/phpstan-banned-code/extension.neon
	- %rootDir%/../phpstan-beberlei-assert/extension.neon
	- %rootDir%/../phpstan-deprecation-rules/rules.neon
	- %rootDir%/../phpstan-doctrine/extension.neon
	- %rootDir%/../phpstan-phpunit/extension.neon
	- %rootDir%/../phpstan-strict-rules/rules.neon
	- %rootDir%/../phpstan-symfony/extension.neon
